+// Temporary WAL-1585 diagnostic. Never part of the durable application.
+// Observe the exact UIKit callbacks wrapped by XCTest; never alter their arguments,
+// return values, animation policy, completion callbacks, or XCTest's counter.
+private enum WalletAnimationTrackerObservation {
+    private static let lock = NSRecursiveLock()
+    private static var sequence = 0
+    private static var callbackCount = 0
+    private static var recent: [[String: Any]] = []
+    private static var dumpedSignatures: Set<String> = []
+    private static var overflow = false
+    private static var pending: [String: [String: Any]] = [:]
+    private static var counts: [String: Int] = [:]
+    private static var creations: [[String: Any]] = []
+    private static var creationCount = 0
+    private static var creationLinksEmitted = 0
+    private static let creationKey = "wal1585AnimationCreation"
+    private static var readBusy: (() -> Bool)?
+
+    static let installed: Void = {
+        guard ProcessInfo.processInfo.environment["E2E_MOCK_WALLET"] == "1",
+              let state = NSClassFromString("UIViewAnimationState"),
+              let notifier = NSClassFromString("XCTAnimationsIdleNotifier"),
+              let busy = class_getClassMethod(notifier, NSSelectorFromString("isAnimationInProgress")),
+              let start = class_getInstanceMethod(state, NSSelectorFromString("animationDidStart:")),
+              let stop = class_getInstanceMethod(state, NSSelectorFromString("animationDidStop:finished:")) else {
+            emit(["event": "unavailable"])
+            return
+        }
+        let busySelector = NSSelectorFromString("isAnimationInProgress")
+        let busyFunction = unsafeBitCast(method_getImplementation(busy), to: (@convention(c) (AnyObject, Selector) -> Bool).self)
+        readBusy = { busyFunction(notifier as AnyObject, busySelector) }
+        typealias Start = @convention(c) (AnyObject, Selector, AnyObject?) -> Void
+        typealias Stop = @convention(c) (AnyObject, Selector, AnyObject?, Bool) -> Void
+        let originalStart = unsafeBitCast(method_getImplementation(start), to: Start.self)
+        let originalStop = unsafeBitCast(method_getImplementation(stop), to: Stop.self)
+        let startSelector = NSSelectorFromString("animationDidStart:")
+        let stopSelector = NSSelectorFromString("animationDidStop:finished:")
+        let startBlock: @convention(block) (AnyObject, AnyObject?) -> Void = { owner, animation in
+            callback("start-enter", owner, animation)
+            originalStart(owner, startSelector, animation)
+            callback("start-exit", owner, animation)
+        }
+        let stopBlock: @convention(block) (AnyObject, AnyObject?, Bool) -> Void = { owner, animation, finished in
+            callback("stop-enter", owner, animation, finished: finished)
+            originalStop(owner, stopSelector, animation, finished)
+            callback("stop-exit", owner, animation, finished: finished)
+        }
+        method_setImplementation(start, imp_implementationWithBlock(startBlock))
+        method_setImplementation(stop, imp_implementationWithBlock(stopBlock))
+        for name in ["UIViewAnimationState", "UIViewSpringAnimationState"] {
+            guard let type = NSClassFromString(name),
+                  let method = class_getInstanceMethod(type, NSSelectorFromString("animationForLayer:forKey:forView:")),
+                  String(cString: method_getTypeEncoding(method)!) == "@40@0:8@16@24@32" else {
+                emit(["event": "creation-unavailable", "class": name])
+                continue
+            }
+            typealias Create = @convention(c) (AnyObject, Selector, AnyObject?, AnyObject?, AnyObject?) -> AnyObject?
+            let selector = NSSelectorFromString("animationForLayer:forKey:forView:")
+            let original = unsafeBitCast(method_getImplementation(method), to: Create.self)
+            let block: @convention(block) (AnyObject, AnyObject?, AnyObject?, AnyObject?) -> AnyObject? = { owner, layer, key, view in
+                let result = original(owner, selector, layer, key, view)
+                recordCreation(owner, animation: result, layer: layer, key: key, view: view)
+                return result
+            }
+            method_setImplementation(method, imp_implementationWithBlock(block))
+            emit(["event": "creation-installed", "class": name, "type": String(cString: method_getTypeEncoding(method)!)])
+        }
+        emit(["event": "installed", "startType": String(cString: method_getTypeEncoding(start)!),
+              "stopType": String(cString: method_getTypeEncoding(stop)!)])
+    }()
+
+    private static func signature(_ animation: CAAnimation) -> String {
+        let basic = animation as? CABasicAnimation
+        return [String(describing: type(of: animation)),
+                (animation as? CAPropertyAnimation)?.keyPath ?? "nil", String(animation.duration),
+                basic?.fromValue.map { String(describing: $0) } ?? "nil",
+                basic?.toValue.map { String(describing: $0) } ?? "nil",
+                basic?.byValue.map { String(describing: $0) } ?? "nil"].joined(separator: "|")
+    }
+
+    private static func recordCreation(_ owner: AnyObject, animation: AnyObject?, layer: AnyObject?, key: AnyObject?, view: AnyObject?) {
+        guard let animation = animation as? CAPropertyAnimation, animation.keyPath == "position" else { return }
+        lock.lock()
+        defer { lock.unlock() }
+        guard animation.value(forKey: creationKey) == nil else { return }
+        creationCount += 1
+        // Diagnostic metadata only: Core Animation supports arbitrary KVC keys.
+        // The copied animation carries this scalar ID; no timing/value/delegate changes.
+        animation.setValue(creationCount, forKey: creationKey)
+        var row: [String: Any] = ["owner": String(describing: ObjectIdentifier(owner)),
+                                  "animation": String(describing: ObjectIdentifier(animation)),
+                                  "signature": signature(animation), "uptime": ProcessInfo.processInfo.systemUptime,
+                                  "key": key.map { String(describing: $0) } ?? "nil",
+                                  "creation": creationCount, "stack": Array(Thread.callStackSymbols.prefix(16))]
+        if let layer = layer as? CALayer {
+            row["layer"] = String(describing: ObjectIdentifier(layer))
+            row["layerClass"] = String(describing: type(of: layer))
+            row["layerBounds"] = String(describing: layer.bounds)
+            row["layerPosition"] = String(describing: layer.position)
+            row["layerDelegateClass"] = layer.delegate.map { String(describing: type(of: $0)) } ?? "nil"
+        }
+        if let view = view as? UIView {
+            var hierarchy: [String] = []
+            var node: UIView? = view
+            while let current = node, hierarchy.count < 10 {
+                hierarchy.append("\(type(of: current))@\(ObjectIdentifier(current)) frame=\(current.frame)")
+                node = current.superview
+            }
+            row["viewHierarchy"] = hierarchy
+        }
+        creations.append(row)
+        if creations.count > 256 { creations.removeFirst() }
+    }
+
+    private static func creationMatches(_ owner: AnyObject, _ animation: CAAnimation) -> [String: Any] {
+        if let token = animation.value(forKey: creationKey) as? Int {
+            let matches = creations.filter { $0["creation"] as? Int == token }
+            return ["match": matches.count == 1 ? "copied-creation-id" : "creation-id-not-retained",
+                    "creationID": token, "candidateCount": matches.count, "candidates": matches]
+        }
+        let ownerID = String(describing: ObjectIdentifier(owner))
+        let owned = creations.filter { $0["owner"] as? String == ownerID }
+        let exact = owned.filter { $0["signature"] as? String == signature(animation) }
+        let chosen = exact.isEmpty ? owned : exact
+        return ["match": exact.isEmpty ? "owner-only" : "owner-and-fingerprint",
+                "candidateCount": chosen.count, "candidates": Array(chosen.suffix(16))]
+    }
+
+    private static func callback(_ event: String, _ owner: AnyObject, _ animation: AnyObject?, finished: Bool? = nil) {
+        lock.lock()
+        defer { lock.unlock() }
+        let key = "\(ObjectIdentifier(owner))/\(animation.map { String(describing: ObjectIdentifier($0)) } ?? "nil")"
+        if event == "start-enter", pending.count < 512 {
+            counts[key, default: 0] += 1
+            if pending[key] == nil {
+                var record: [String: Any] = ["key": key, "started": ProcessInfo.processInfo.systemUptime,
+                                           "ownerClass": String(describing: type(of: owner)),
+                                           "returnAddresses": Thread.callStackReturnAddresses.map { $0.stringValue }]
+                if let animation = animation as? CAAnimation {
+                    if (animation as? CAPropertyAnimation)?.keyPath == "position" {
+                        let creation = creationMatches(owner, animation)
+                        record["creation"] = creation
+                        if creationLinksEmitted < 3 {
+                            creationLinksEmitted += 1
+                            emit(["event": "creation-link", "creation": creation])
+                        }
+                    }
+                    record["animationClass"] = String(describing: type(of: animation))
+                    record["duration"] = animation.duration
+                    record["repeat"] = animation.repeatCount
+                    record["speed"] = animation.speed
+                    record["removed"] = animation.isRemovedOnCompletion
+                    if let property = animation as? CAPropertyAnimation { record["keyPath"] = property.keyPath ?? "nil" }
+                }
+                pending[key] = record
+
+            }
+        }
+        if event == "stop-exit", let count = counts[key] {
+            if count > 1 { counts[key] = count - 1 }
+            else { counts.removeValue(forKey: key); pending.removeValue(forKey: key) }
+        }
+        var record: [String: Any] = ["event": event, "key": key, "balance": counts[key, default: 0],
+                                    "pending": pending.count, "xctBusy": readBusy?() as Any? ?? "unavailable"]
+        if let finished { record["finished"] = finished }
+        callbackCount += 1
+        record["callback"] = callbackCount
+        record["uptime"] = ProcessInfo.processInfo.systemUptime
+        record["main"] = Thread.isMainThread
+        recent.append(record)
+        if recent.count > 192 { recent.removeFirst() }
+        if pending.count >= 512 { overflow = true }
+    }
+
+    static func snapshot(_ phase: String) {
+        lock.lock()
+        defer { lock.unlock() }
+        let busy = readBusy?()
+        emit(["event": "snapshot", "phase": phase, "pending": pending.count,
+              "callbacks": callbackCount, "creations": creationCount, "overflow": overflow,
+              "xctBusy": busy as Any? ?? "unavailable"])
+        let signature = "\(busy as Any? ?? "unavailable")/" + pending.keys.sorted().joined(separator: ";")
+        guard busy == true || !pending.isEmpty,
+              dumpedSignatures.count < 8, dumpedSignatures.insert(signature).inserted else { return }
+        for row in recent { emit(["event": "callback", "phase": phase, "record": row]) }
+        for key in pending.keys.sorted().prefix(30) {
+            emit(["event": "pending", "phase": phase, "balance": counts[key, default: 0], "record": pending[key]!])
+        }
+    }
+
+    private static func emit(_ fields: [String: Any]) {
+        lock.lock()
+        defer { lock.unlock() }
+        guard sequence < 3000 else { return }
+        sequence += 1
+        var row = fields
+        row["sequence"] = sequence
+        row["uptime"] = ProcessInfo.processInfo.systemUptime
+        row["pid"] = ProcessInfo.processInfo.processIdentifier
+        row["main"] = Thread.isMainThread
+        guard let data = try? JSONSerialization.data(withJSONObject: row, options: [.sortedKeys]),
+              var line = "WAL1585 tracker ".data(using: .utf8) else { return }
+        line.append(data)
+        line.append(10)
+        FileHandle.standardError.write(line)
+    }
+}
