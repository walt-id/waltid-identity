+// Temporary diagnostic: record animation metadata, never text or request contents.
+private func traceSheetAnimations(_ root: CALayer, phase: String) {
+    var pending = [root]
+    var count = 0
+    while let layer = pending.popLast() {
+        pending.append(contentsOf: layer.sublayers ?? [])
+        for key in layer.animationKeys() ?? [] {
+            guard let animation = layer.animation(forKey: key) else { continue }
+            count += 1
+            NSLog("SHEET_TRACE %@ %.6f layer=%@ key=%@ duration=%.6f repeat=%.2f repeatDuration=%.2f begin=%.6f", phase, CACurrentMediaTime(), layer.delegate.map { String(describing: type(of: $0)) } ?? "nil", key, animation.duration, animation.repeatCount, animation.repeatDuration, animation.beginTime)
+        }
+    }
+    NSLog("SHEET_TRACE %@ %.6f animationCount=%d", phase, CACurrentMediaTime(), count)
+}
