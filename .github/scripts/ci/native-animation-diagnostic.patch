 import SwiftUI
 import UIKit
+
+// Temporary diagnostic: record animation metadata from every app-owned window, never input values.
+@MainActor
+private func traceWalletWindowAnimations(phase: String) {
+    let windows = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }.flatMap(\.windows)
+    for window in windows {
+        let name = String(describing: type(of: window))
+        var pending = [window.layer]
+        var count = 0
+        while let layer = pending.popLast() {
+            pending.append(contentsOf: layer.sublayers ?? [])
+            for key in layer.animationKeys() ?? [] {
+                guard let animation = layer.animation(forKey: key) else { continue }
+                count += 1
+                NSLog("SHEET_TRACE %@ %.6f window=%@ hidden=%d layer=%@ delegate=%@ key=%@ animation=%@ duration=%.6f repeat=%.2f repeatDuration=%.2f begin=%.6f speed=%.3f removed=%d fill=%@", phase, CACurrentMediaTime(), name, window.isHidden, String(describing: ObjectIdentifier(layer)), layer.delegate.map { String(describing: type(of: $0)) } ?? "nil", key, String(describing: type(of: animation)), animation.duration, animation.repeatCount, animation.repeatDuration, animation.beginTime, animation.speed, animation.isRemovedOnCompletion, animation.fillMode.rawValue)
+            }
+        }
+        NSLog("SHEET_TRACE %@ %.6f window=%@ hidden=%d alpha=%.2f animationCount=%d", phase, CACurrentMediaTime(), name, window.isHidden, window.alpha, count)
+    }
+}

