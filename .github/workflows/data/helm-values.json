{
  "issuer2": {
    "api": {
      "image": {
        "tag": "latest"
      }
    },
    "ingress": {
      "host": "issuer2.portal.test.waltid.cloud",
      "clusterIssuer": "letsencrypt-prod",
      "tls": [
        {
          "secretName": "issuer2-tls-secret",
          "hosts": [
            "issuer2.portal.test.waltid.cloud"
          ]
        }
      ]
    }
  },
  "verifier2": {
    "api": {
      "image": {
        "tag": "latest"
      }
    },
    "ingress": {
      "host": "verifier2.portal.test.waltid.cloud",
      "clusterIssuer": "letsencrypt-prod",
      "tls": [
        {
          "secretName": "verifier2-tls-secret",
          "hosts": [
            "verifier2.portal.test.waltid.cloud"
          ]
        }
      ]
    }
  },
  "portal2": {
    "env": {
      "NUXT_PUBLIC_ISSUER_BASE": "https://issuer2.portal.test.waltid.cloud",
      "NUXT_PUBLIC_VERIFIER_BASE": "https://verifier2.portal.test.waltid.cloud",
      "NUXT_PUBLIC_WALLET_URL": "https://wallet2.test.waltid.cloud"
    },
    "api": {
      "image": {
        "tag": "latest"
      }
    },
    "ingress": {
      "host": "portal2.test.waltid.cloud",
      "clusterIssuer": "letsencrypt-prod",
      "tls": [
        {
          "secretName": "portal2-tls-secret",
          "hosts": [
            "portal2.test.waltid.cloud"
          ]
        }
      ]
    }
  },
  "wallet-api2": {
    "api": {
      "image": {
        "tag": "latest"
      }
    },
    "configFiles": {
      "auth.conf": "signingKey = __DEFAULT_WALLET2_AUTH_SIGNING_KEY__\ntokenExpiry = \"PT24H\""
    },
    "ingress": {
      "host": "wallet2.test.waltid.cloud"
    }
  },
  "wallet2": {
    "env": {
      "WALLET_API2_PUBLIC_URL": "https://wallet2.test.waltid.cloud"
    },
    "api": {
      "image": {
        "tag": "latest"
      }
    },
    "ingress": {
      "host": "wallet2.test.waltid.cloud",
      "clusterIssuer": "letsencrypt-prod",
      "tls": [
        {
          "secretName": "wallet2-tls-secret",
          "hosts": [
            "wallet2.test.waltid.cloud"
          ]
        }
      ]
    }
  }
}