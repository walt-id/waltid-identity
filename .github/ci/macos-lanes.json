{
  "shared": [
    ".github/workflows/build.yml",
    ".github/workflows/gradle-macos.yml",
    ".github/workflows/macos-eligibility.yml",
    ".github/workflows/platform-eligibility.yml",
    ".github/ci/*",
    ".github/scripts/ci/*",
    ".github/actions/checkout-repos/*",
    ".github/actions/gradle-ios/*",
    ".github/actions/gradle-setup-action/*",
    ".github/actions/ios-build-setup/*",
    ".github/actions/set-properties/*",
    "build-logic/*",
    "build.gradle.kts",
    "gradle/*",
    "gradle.properties",
    "gradlew",
    "settings.gradle.kts",
    "gradle/libs.versions.toml",
    ".github/scripts/mobile-ci/*",
    "scripts/proximity-physical/*"
  ],
  "lanes": {
    "ios-simulator": {
      "description": "Kotlin iOS compilation and iosSimulatorArm64 tests",
      "patterns": [
        "*/src/commonMain/*",
        "*/src/commonTest/*",
        "*/src/iosMain/*",
        "*/src/iosTest/*",
        "waltid-libraries/*/build.gradle.kts",
        "waltid-libraries/*/*/build.gradle.kts",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-mobile/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-persistence-mobile/*",
        "*/src/iosSimulatorArm64Test/*"
      ]
    },
    "native": {
      "description": "WalletCore XCFramework, Swift package, and native Xcode demo",
      "patterns": [
        "*/Package.swift",
        ".github/scripts/mobile-ci/run-ios-wallet-sdk-tests.sh",
        ".github/scripts/mobile-ci/verify_test_results.py",
        ".github/scripts/mobile-ci/proximity-test-suites.json",
        "scripts/check-mobile-swift-parity-decision.sh",
        "waltid-applications/waltid-wallet-demo-ios/*",
        "waltid-applications/waltid-wallet-demo-shared-ios/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-mobile/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-persistence-mobile/*",
        "waltid-libraries/protocols/waltid-wallet-sdk-ios/*"
      ]
    },
    "compose": {
      "description": "Compose iOS demo and its WalletCore/Swift integration",
      "patterns": [
        "waltid-applications/waltid-wallet-demo-compose/*",
        "waltid-applications/waltid-wallet-demo-shared-ios/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-mobile/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-persistence-mobile/*",
        "waltid-libraries/protocols/waltid-wallet-sdk-ios/*"
      ]
    },
    "enterprise": {
      "description": "Enterprise iOS mobile integration against Identity wallet-mobile",
      "patterns": [
        "waltid-libraries/protocols/waltid-openid4vc-wallet-mobile/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-persistence-mobile/*",
        "waltid-libraries/protocols/waltid-wallet-sdk-ios/*"
      ]
    },
    "sdk-docs": {
      "description": "Mobile SDK ABI, Dokka, snippets, and Swift DocC",
      "patterns": [
        ".github/workflows/mobile-sdk-docs.yml",
        ".github/actions/gradle-mobile-sdk-docs/*",
        "scripts/check-mobile-swift-parity-decision.sh",
        "docs/mobile-sdk-api/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-mobile/*",
        "waltid-libraries/protocols/waltid-openid4vc-wallet-persistence-mobile/*",
        "waltid-libraries/protocols/waltid-wallet-sdk-ios/*"
      ]
    }
  }
}
