CREATE TABLE key_references (
    key_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    stored_key TEXT NOT NULL
);

selectAll:
SELECT * FROM key_references;

selectByKeyId:
SELECT * FROM key_references WHERE key_id = ?;

insert:
INSERT INTO key_references (
    key_id,
    created_at,
    stored_key
)
VALUES (?, ?, ?);

deleteByKeyId:
DELETE FROM key_references WHERE key_id = ?;

-- Credentials

CREATE TABLE credentials (
    id TEXT NOT NULL PRIMARY KEY,
    serialized_credential TEXT NOT NULL,
    format TEXT NOT NULL DEFAULT '',
    label TEXT,
    added_at INTEGER NOT NULL,
    metadata TEXT,
    holder_key_binding TEXT
);

selectAllCredentials:
SELECT * FROM credentials;

selectCredentialById:
SELECT * FROM credentials WHERE id = ?;

selectStatusInput:
SELECT credentials.id, credentials.serialized_credential, snapshots.snapshot, snapshots.notice
FROM credentials LEFT JOIN credential_status_snapshots AS snapshots ON snapshots.credential_id = credentials.id
WHERE credentials.id = ?;

firstMaintenanceIds:
SELECT id FROM credentials ORDER BY id LIMIT 64;

nextMaintenanceIds:
SELECT id FROM credentials WHERE id > ? ORDER BY id LIMIT 64;

firstStatusPage:
SELECT credentials.id, credentials.serialized_credential, snapshots.snapshot, snapshots.notice
FROM credentials LEFT JOIN credential_status_snapshots AS snapshots ON snapshots.credential_id = credentials.id
ORDER BY credentials.id LIMIT ?;

nextStatusPage:
SELECT credentials.id, credentials.serialized_credential, snapshots.snapshot, snapshots.notice
FROM credentials LEFT JOIN credential_status_snapshots AS snapshots ON snapshots.credential_id = credentials.id
WHERE credentials.id > ? ORDER BY credentials.id LIMIT ?;

countStatusInputsAfter:
SELECT count(*) FROM credentials WHERE id > ?;

insertCredential:
INSERT OR REPLACE INTO credentials (id, serialized_credential, format, label, added_at, metadata, holder_key_binding)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteCredentialById:
DELETE FROM credentials WHERE id = ?;

CREATE TABLE credential_inventory (
    credential_id TEXT NOT NULL PRIMARY KEY REFERENCES credentials(id) ON DELETE CASCADE,
    issuer TEXT,
    subject TEXT,
    type_metadata TEXT NOT NULL
);

CREATE TRIGGER invalidate_inventory_on_insert AFTER INSERT ON credentials BEGIN
    DELETE FROM credential_inventory WHERE credential_id = new.id;
END;

CREATE TRIGGER invalidate_inventory_on_update AFTER UPDATE OF serialized_credential, id ON credentials BEGIN
    DELETE FROM credential_inventory WHERE credential_id IN (old.id, new.id);
END;

CREATE TRIGGER invalidate_inventory_on_delete AFTER DELETE ON credentials BEGIN
    DELETE FROM credential_inventory WHERE credential_id = old.id;
END;

selectCredentialSummaries:
SELECT c.id, c.format, c.label, c.added_at, c.metadata, i.issuer, i.subject, i.type_metadata
FROM credentials AS c LEFT JOIN credential_inventory AS i ON i.credential_id = c.id;

saveCredentialInventory:
INSERT OR REPLACE INTO credential_inventory (credential_id, issuer, subject, type_metadata)
VALUES (?, ?, ?, ?);

saveCredentialInventoryIfCurrent:
INSERT OR REPLACE INTO credential_inventory (credential_id, issuer, subject, type_metadata)
SELECT id, :issuer, :subject, :type_metadata FROM credentials
WHERE id = :credential_id AND serialized_credential = :expected_credential;

-- Small authenticated observations, protected by the same encrypted database as credentials.
CREATE TABLE credential_status_snapshots (
    credential_id TEXT NOT NULL PRIMARY KEY REFERENCES credentials(id) ON DELETE CASCADE,
    snapshot TEXT NOT NULL,
    notice TEXT
);

selectCredentialStatus:
SELECT snapshot FROM credential_status_snapshots WHERE credential_id = ?;

selectCredentialStatusNotice:
SELECT notice FROM credential_status_snapshots WHERE credential_id = ?;

updateCredentialStatusNotice:
UPDATE credential_status_snapshots SET notice = :notice WHERE credential_id = :credential_id;

saveCredentialStatusIfCurrent:
INSERT OR REPLACE INTO credential_status_snapshots (credential_id, snapshot, notice)
SELECT id, :snapshot, :notice FROM credentials
WHERE id = :credential_id AND serialized_credential = :expected_credential
AND (SELECT snapshot FROM credential_status_snapshots WHERE credential_id = :credential_id) IS :expected_snapshot;

credentialStatusChanges:
SELECT changes();

deleteCredentialStatusForReplacement:
DELETE FROM credential_status_snapshots WHERE credential_id = :id
AND NOT EXISTS (SELECT 1 FROM credentials WHERE id = :id AND serialized_credential = :serialized_credential);

deleteCredentialStatus:
DELETE FROM credential_status_snapshots WHERE credential_id = ?;

-- Foreground opt-in with a nullable generation while automatic checks are paused.
CREATE TABLE credential_status_maintenance (
    wallet_id TEXT NOT NULL PRIMARY KEY,
    grant_id TEXT,
    cursor_id TEXT
);

selectCredentialStatusMaintenance:
SELECT * FROM credential_status_maintenance WHERE wallet_id = ?;

setCredentialStatusMaintenance:
INSERT OR REPLACE INTO credential_status_maintenance(wallet_id, grant_id, cursor_id)
VALUES (:wallet_id, :grant_id, (SELECT cursor_id FROM credential_status_maintenance WHERE wallet_id = :wallet_id));

advanceCredentialStatusMaintenance:
UPDATE credential_status_maintenance SET cursor_id = :next_id
WHERE wallet_id = :wallet_id AND grant_id = :grant_id AND cursor_id IS :previous_id;

deleteCredentialStatusMaintenance:
DELETE FROM credential_status_maintenance WHERE wallet_id = ?;

-- DIDs

CREATE TABLE dids (
    did TEXT NOT NULL PRIMARY KEY,
    document TEXT NOT NULL
);

selectAllDids:
SELECT * FROM dids;

selectDidByDid:
SELECT * FROM dids WHERE did = ?;

insertDid:
INSERT OR REPLACE INTO dids (did, document)
VALUES (?, ?);

deleteDidByDid:
DELETE FROM dids WHERE did = ?;

-- Sensitive OpenID4VCI continuation records. The containing database is SQLCipher-encrypted.

CREATE TABLE issuance_session_records (
    record_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

selectAllIssuanceSessionRecords:
SELECT * FROM issuance_session_records;

selectIssuanceSessionRecordById:
SELECT * FROM issuance_session_records WHERE record_id = ?;

insertIssuanceSessionRecord:
INSERT OR REPLACE INTO issuance_session_records (record_id, session_id, kind, payload, updated_at)
VALUES (?, ?, ?, ?, ?);

insertIssuanceSessionRecordIfAbsent:
INSERT OR IGNORE INTO issuance_session_records (record_id, session_id, kind, payload, updated_at)
VALUES (?, ?, ?, ?, ?);

deleteIssuanceSessionRecordById:
DELETE FROM issuance_session_records WHERE record_id = ?;

compareAndSetIssuanceSessionRecord:
UPDATE issuance_session_records
SET session_id = :replacement_session_id, kind = :replacement_kind,
    payload = :replacement_payload, updated_at = :replacement_updated_at
WHERE record_id = :record_id AND session_id = :expected_session_id AND kind = :expected_kind
    AND payload = :expected_payload AND updated_at = :expected_updated_at;

issuanceSessionRecordChanges:
SELECT changes();

compareAndRemoveIssuanceSessionRecord:
DELETE FROM issuance_session_records
WHERE record_id = :record_id AND session_id = :expected_session_id AND kind = :expected_kind
    AND payload = :expected_payload AND updated_at = :expected_updated_at;

-- Identity operations are journaled before native or backup side effects.
CREATE TABLE wallet_identity_records (
    wallet_id TEXT NOT NULL PRIMARY KEY,
    phase TEXT NOT NULL,
    payload TEXT NOT NULL
);

CREATE TABLE wallet_active_identity (
    wallet_id TEXT NOT NULL PRIMARY KEY,
    identity_id TEXT NOT NULL,
    key_id TEXT NOT NULL,
    did TEXT NOT NULL
);

selectIdentityRecords:
SELECT * FROM wallet_identity_records;

selectIdentityRecord:
SELECT * FROM wallet_identity_records WHERE wallet_id = ?;

putIdentityRecord:
INSERT OR REPLACE INTO wallet_identity_records (wallet_id, phase, payload) VALUES (?, ?, ?);

deleteIdentityRecord:
DELETE FROM wallet_identity_records WHERE wallet_id = ?;

selectActiveIdentity:
SELECT active.* FROM wallet_active_identity AS active
INNER JOIN wallet_identity_records AS record ON record.wallet_id = active.wallet_id
WHERE active.wallet_id = ? AND record.phase = 'Active';

setActiveIdentity:
INSERT OR REPLACE INTO wallet_active_identity (wallet_id, identity_id, key_id, did) VALUES (?, ?, ?, ?);
