CREATE TABLE key_references (
    key_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    stored_key TEXT NOT NULL
);

selectAll:
SELECT * FROM key_references;

selectByKeyId:
SELECT * FROM key_references WHERE key_id = ?;

insert:
INSERT INTO key_references (
    key_id,
    created_at,
    stored_key
)
VALUES (?, ?, ?);

deleteByKeyId:
DELETE FROM key_references WHERE key_id = ?;

-- Credentials

CREATE TABLE credentials (
    id TEXT NOT NULL PRIMARY KEY,
    serialized_credential TEXT NOT NULL,
    format TEXT NOT NULL DEFAULT '',
    label TEXT,
    added_at INTEGER NOT NULL,
    metadata TEXT
);

selectAllCredentials:
SELECT * FROM credentials;

selectCredentialById:
SELECT * FROM credentials WHERE id = ?;

insertCredential:
INSERT OR REPLACE INTO credentials (id, serialized_credential, format, label, added_at, metadata)
VALUES (?, ?, ?, ?, ?, ?);

deleteCredentialById:
DELETE FROM credentials WHERE id = ?;

-- DIDs

CREATE TABLE dids (
    did TEXT NOT NULL PRIMARY KEY,
    document TEXT NOT NULL
);

selectAllDids:
SELECT * FROM dids;

selectDidByDid:
SELECT * FROM dids WHERE did = ?;

insertDid:
INSERT OR REPLACE INTO dids (did, document)
VALUES (?, ?);

deleteDidByDid:
DELETE FROM dids WHERE did = ?;

-- Sensitive OpenID4VCI continuation records. The containing database is SQLCipher-encrypted.

CREATE TABLE issuance_session_records (
    record_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

selectAllIssuanceSessionRecords:
SELECT * FROM issuance_session_records;

selectIssuanceSessionRecordById:
SELECT * FROM issuance_session_records WHERE record_id = ?;

insertIssuanceSessionRecord:
INSERT OR REPLACE INTO issuance_session_records (record_id, session_id, kind, payload, updated_at)
VALUES (?, ?, ?, ?, ?);

deleteIssuanceSessionRecordById:
DELETE FROM issuance_session_records WHERE record_id = ?;
