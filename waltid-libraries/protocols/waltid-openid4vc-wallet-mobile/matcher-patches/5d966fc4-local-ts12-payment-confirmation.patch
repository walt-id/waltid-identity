new file mode 100644
index 0000000..2744d15
--- /dev/null
+++ b/CredentialProvider/wasm/matcher-rs/src/payment.rs
@@ -0,0 +1,488 @@
+//! Local TS-12 system-sheet projection. Trust is established by the wallet before registration;
+//! the sandbox only selects authenticated labels and renders the original request's values.
+use crate::base64url::decode_base64url;
+use crate::openid4vp_models::{MatchedCredential, OpenId4VpData};
+use serde_json::{Map, Value};
+use std::collections::BTreeMap;
+
+type Error = Box<dyn std::error::Error>;
+const TYPE: &str = "urn:eudi:sca:payment:1";
+pub struct PaymentDisplay {
+    pub subtitle: String,
+    pub amount: String,
+}
+
+pub struct Payment {
+    pub ids: Vec<String>,
+    pub merchant: String,
+    pub amount: String,
+    pub payload: Value,
+}
+
+/// Decimal expansion is bounded and never passes through IEEE-754. Input is a JSON number token.
+pub fn exact_amount(token: &str, currency: &str) -> Result<String, Error> {
+    let units = minor_units(currency).ok_or("Unsupported payment currency")?;
+    if token.len() > 128 {
+        return Err("Payment number too long".into());
+    }
+    let (negative, unsigned) = token
+        .strip_prefix('-')
+        .map_or((false, token), |v| (true, v));
+    let mut parts = unsigned.split(['e', 'E']);
+    let mantissa = parts.next().ok_or("Missing number")?;
+    let exponent = parts
+        .next()
+        .map(str::parse::<i32>)
+        .transpose()?
+        .unwrap_or(0);
+    if parts.next().is_some() || !(-128..=128).contains(&exponent) {
+        return Err("Unsupported exponent".into());
+    }
+    let mut components = mantissa.split('.');
+    let whole = components.next().ok_or("Missing whole number")?;
+    let fraction = components.next().unwrap_or("");
+    if components.next().is_some()
+        || whole.is_empty()
+        || !whole.bytes().all(|c| c.is_ascii_digit())
+        || !fraction.bytes().all(|c| c.is_ascii_digit())
+    {
+        return Err("Invalid number".into());
+    }
+    let digits = format!("{whole}{fraction}");
+    let point = whole.len() as i32 + exponent;
+    let (whole, fraction) = if point <= 0 {
+        (
+            "0".to_owned(),
+            format!("{}{digits}", "0".repeat((-point) as usize)),
+        )
+    } else if point as usize >= digits.len() {
+        (
+            format!("{digits}{}", "0".repeat(point as usize - digits.len())),
+            String::new(),
+        )
+    } else {
+        (
+            digits[..point as usize].to_owned(),
+            digits[point as usize..].to_owned(),
+        )
+    };
+    let whole = whole.trim_start_matches('0');
+    let whole = if whole.is_empty() { "0" } else { whole };
+    let fraction = fraction.trim_end_matches('0');
+    if fraction.len() > units {
+        return Err("Payment exceeds currency precision".into());
+    }
+    let fraction = format!("{fraction:0<units$}");
+    Ok(format!(
+        "{}{whole}{}",
+        if negative { "-" } else { "" },
+        if units == 0 {
+            String::new()
+        } else {
+            format!(".{fraction}")
+        }
+    ))
+}
+
+pub fn parse(data: &OpenId4VpData) -> Result<Option<Payment>, Error> {
+    let entries: Vec<Value> = data
+        .transaction_data
+        .iter()
+        .map(|raw| Ok(serde_json::from_slice(&decode_base64url(raw)?)?))
+        .collect::<Result<_, Error>>()?;
+    if !entries.iter().any(|v| v["type"] == TYPE) {
+        return Ok(None);
+    }
+    if entries.len() != 1 {
+        return Err("System payment confirmation supports exactly one transaction".into());
+    }
+    let entry = &entries[0];
+    let object = entry.as_object().ok_or("Invalid transaction")?;
+    if object.keys().any(|k| {
+        ![
+            "type",
+            "credential_ids",
+            "transaction_data_hashes_alg",
+            "require_cryptographic_holder_binding",
+            "payload",
+        ]
+        .contains(&k.as_str())
+    }) {
+        return Err("Unsupported transaction extension".into());
+    }
+    if object
+        .get("require_cryptographic_holder_binding")
+        .is_some_and(|value| value.as_bool() != Some(true))
+    {
+        return Err("Payment requires cryptographic holder binding".into());
+    }
+    let ids: Vec<String> = entry["credential_ids"]
+        .as_array()
+        .ok_or("Missing credential IDs")?
+        .iter()
+        .map(|id| {
+            id.as_str()
+                .filter(|s| !s.is_empty())
+                .map(str::to_owned)
+                .ok_or("Invalid credential ID".into())
+        })
+        .collect::<Result<_, Error>>()?;
+    if ids.is_empty() {
+        return Err("Missing credential IDs".into());
+    }
+    let payload = &entry["payload"];
+    let values = payload.as_object().ok_or("Missing payment payload")?;
+    let required = ["transaction_id", "payee", "currency", "amount"];
+    if required.iter().any(|k| !values.contains_key(*k)) {
+        return Err("Missing required payment parameter".into());
+    }
+    for (key, value) in values {
+        match key.as_str() {
+            "payee" => string_object(value, &["name", "id", "logo", "website"], &["name", "id"])?,
+            "pisp" => string_object(
+                value,
+                &["legal_name", "brand_name", "domain_name"],
+                &["legal_name", "brand_name", "domain_name"],
+            )?,
+            "amount" => {
+                if !value.is_number() {
+                    return Err("Amount must be a number".into());
+                }
+            }
+            "amount_estimated" | "amount_earmarked" | "sct_inst" => {
+                if !value.is_boolean() {
+                    return Err("Invalid payment flag".into());
+                }
+            }
+            "transaction_id" | "date_time" | "currency" => {
+                nonblank(value)?;
+            }
+            _ => {
+                return Err(
+                    "System payment confirmation supports only unscheduled one-off payments".into(),
+                );
+            }
+        }
+    }
+    if nonblank(&payload["transaction_id"])?.chars().count() > 36 {
+        return Err("Invalid transaction ID".into());
+    }
+    let currency = nonblank(&payload["currency"])?;
+    let amount = exact_amount(&payload["amount"].to_string(), currency)?;
+    Ok(Some(Payment {
+        ids,
+        merchant: single_line(nonblank(&payload["payee"]["name"])?),
+        amount: format!("{currency} {amount}"),
+        payload: payload.clone(),
+    }))
+}
+fn string_object(value: &Value, allowed: &[&str], required: &[&str]) -> Result<(), Error> {
+    let object = value.as_object().ok_or("Invalid payment object")?;
+    if required.iter().any(|k| !object.contains_key(*k)) {
+        return Err("Missing payment parameter".into());
+    }
+    for (key, value) in object {
+        if !allowed.contains(&key.as_str()) {
+            return Err("Unsupported payment parameter".into());
+        }
+        nonblank(value)?;
+    }
+    Ok(())
+}
+fn nonblank(value: &Value) -> Result<&str, Error> {
+    value
+        .as_str()
+        .filter(|s| !s.trim().is_empty())
+        .ok_or("Missing payment text".into())
+}
+fn at<'a>(mut value: &'a Value, path: &[String]) -> Option<&'a Value> {
+    for part in path {
+        value = value.as_object()?.get(part)?;
+    }
+    Some(value)
+}
+fn path(rule: &Value) -> Result<Vec<String>, Error> {
+    rule["path"]
+        .as_array()
+        .ok_or("Missing label path")?
+        .iter()
+        .map(|p| Ok(nonblank(p)?.to_owned()))
+        .collect()
+}
+fn leaves(value: &Value, prefix: Vec<String>, result: &mut BTreeMap<Vec<String>, Value>) {
+    if let Some(object) = value.as_object() {
+        for (key, child) in object {
+            let mut path = prefix.clone();
+            path.push(key.clone());
+            leaves(child, path, result);
+        }
+    } else {
+        result.insert(prefix, value.clone());
+    }
+}
+fn matching<'a>(labels: &'a Map<String, Value>, range: &str) -> Option<&'a Value> {
+    labels.get(range).or_else(|| {
+        labels
+            .iter()
+            .find(|(key, _)| key.starts_with(&format!("{range}-")))
+            .map(|(_, value)| value)
+    })
+}
+fn single_line(value: &str) -> String {
+    value
+        .chars()
+        .map(|c| {
+            if c.is_control() || matches!(c, '\u{2028}'..='\u{202e}' | '\u{2066}'..='\u{2069}') {
+                format!("\\u{:04x}", c as u32)
+            } else {
+                c.to_string()
+            }
+        })
+        .collect()
+}
+fn value_text(value: &Value, locale: &str) -> String {
+    let text = match value {
+        Value::String(s) => s.clone(),
+        Value::Bool(v) => match (locale.split('-').next().unwrap_or(""), v) {
+            ("de", true) => "Ja",
+            ("de", false) => "Nein",
+            (_, true) => "Yes",
+            (_, false) => "No",
+        }
+        .to_owned(),
+        _ => value.to_string(),
+    };
+    // Isolate each request/claim value; it must not inject a new instruction line or reorder labels.
+    format!("\u{2068}{}\u{2069}", single_line(&text))
+}
+
+/// Returns issuer-labelled transaction parameters and selected attributes for one payment candidate.
+/// Missing metadata or a common translation means there is no truthful system payment candidate.
+pub fn subtitle(
+    payment: &Payment,
+    credential: &MatchedCredential<'_>,
+    registry: &Value,
+    unsigned: bool,
+) -> Result<PaymentDisplay, Error> {
+    let configuration = &registry["walt_payment_instructions_v1"][credential.id];
+    let document = &configuration["document"];
+    let claims = document["claims"]
+        .as_array()
+        .ok_or("No authenticated payment instructions")?;
+    let credential_rules = document["credential_claims"]
+        .as_array()
+        .ok_or("No authenticated claim instructions")?;
+    let ui = document["ui_labels"]
+        .as_object()
+        .ok_or("No authenticated UI instructions")?;
+    if !ui.contains_key("affirmative_action_label") {
+        return Err("Missing action label".into());
+    }
+    let mut values = BTreeMap::new();
+    leaves(&payment.payload, vec![], &mut values);
+    let mut fields: Vec<(&Value, Value)> = vec![];
+    let mut transaction_amount_index = None;
+    for rule in claims {
+        let path = path(rule)?;
+        if let Some(value) = values.remove(&path) {
+            if path == ["amount"] {
+                transaction_amount_index = Some(fields.len());
+            }
+            fields.push((rule, value));
+        } else if rule["mandatory"] == true && at(&payment.payload, &path).is_none() {
+            return Err("Missing mandatory payment parameter".into());
+        }
+    }
+    if !values.is_empty() {
+        return Err("Payment parameter has no authenticated label".into());
+    }
+    let record = registry["credentials"]["dc+sd-jwt"]
+        .as_object()
+        .and_then(|types| {
+            types
+                .values()
+                .filter_map(Value::as_array)
+                .flatten()
+                .find(|r| r["id"].as_str() == Some(credential.id))
+        })
+        .ok_or("Missing registered payment credential")?;
+    for path in &credential.matched_claim_metadata {
+        let rule = credential_rules
+            .iter()
+            .find(|r| self::path(r).is_ok_and(|p| p.as_slice() == *path))
+            .ok_or("Requested attribute has no authenticated label")?;
+        let field = at(&record["paths"], path).ok_or("Missing selected attribute")?;
+        fields.push((
+            rule,
+            field.get("value").ok_or("Missing selected value")?.clone(),
+        ));
+    }
+    let label_sets: Vec<&Map<String, Value>> = fields
+        .iter()
+        .map(|(r, _)| r["labels"].as_object().ok_or("Missing labels"))
+        .chain(
+            ui.values()
+                .map(|v| v.as_object().ok_or("Missing UI translations")),
+        )
+        .collect::<Result<_, _>>()?;
+    let mut candidates: Vec<String> = vec![];
+    for preference in configuration["locales"]
+        .as_array()
+        .ok_or("Missing languages")?
+    {
+        let mut range = nonblank(preference)?.to_ascii_lowercase();
+        loop {
+            if !candidates.contains(&range) {
+                candidates.push(range.clone());
+            }
+            let Some((parent, _)) = range.rsplit_once('-') else {
+                break;
+            };
+            range = parent.to_owned();
+            if range.rsplit('-').next().is_some_and(|p| p.len() == 1) {
+                range = range.rsplit_once('-').map_or("", |p| p.0).to_owned();
+            }
+            if range.is_empty() {
+                break;
+            }
+        }
+    }
+    let needs_wallet_translation = unsigned || fields.iter().any(|(_, v)| v.is_boolean());
+    let locale = candidates
+        .iter()
+        .find(|c| {
+            (!needs_wallet_translation || ["en", "de"].contains(&c.split('-').next().unwrap_or("")))
+                && label_sets
+                    .iter()
+                    .all(|labels| matching(labels, c).is_some())
+        })
+        .ok_or("Missing preferred language")?;
+    let number_format = &registry["walt_payment_number_formats_v1"][locale];
+    let separator = nonblank(&number_format["decimal_separator"])?;
+    let zero = nonblank(&number_format["zero_digit"])?
+        .chars()
+        .next()
+        .ok_or("Missing number format")? as u32;
+    let amount: String = payment
+        .amount
+        .chars()
+        .map(|c| {
+            if c == '.' {
+                Ok(separator.to_owned())
+            } else if c.is_ascii_digit() {
+                char::from_u32(zero + (c as u32 - '0' as u32))
+                    .map(|v| v.to_string())
+                    .ok_or("Invalid digit format")
+            } else {
+                Ok(c.to_string())
+            }
+        })
+        .collect::<Result<_, _>>()?;
+    let mut lines = vec![];
+    if unsigned {
+        lines.push(
+            if locale.starts_with("de") {
+                "Unsignierte Anfrage. Prüfen Sie die Zahlungsdaten vor dem Bestätigen."
+            } else {
+                "Unsigned request. Check the payment details before confirming."
+            }
+            .to_owned(),
+        );
+    }
+    // The ordinary credential caption is a type label, not a payment instruction.
+    // Card identity remains in the title and issuer-labelled requested attributes below.
+    for key in ["transaction_title", "security_hint"] {
+        if let Some(labels) = ui.get(key).and_then(Value::as_object) {
+            lines.push(single_line(nonblank(
+                matching(labels, locale).ok_or("Missing UI label")?,
+            )?));
+        }
+    }
+    for (index, (rule, mut value)) in fields.into_iter().enumerate() {
+        if rule["visualisation"] == 4 {
+            continue;
+        }
+        let label = matching(rule["labels"].as_object().ok_or("Missing labels")?, locale)
+            .ok_or("Missing label")?;
+        if transaction_amount_index == Some(index) {
+            value = Value::String(amount.clone());
+        }
+        lines.push(format!(
+            "{}: {}",
+            single_line(nonblank(&label["label"])?),
+            value_text(&value, locale)
+        ));
+        if let Some(description) = label.get("description") {
+            lines.push(single_line(nonblank(description)?));
+        }
+    }
+    let subtitle = lines.join("\n");
+    if subtitle.len() > 16384 {
+        return Err("Payment instructions exceed system projection limit".into());
+    }
+    Ok(PaymentDisplay { subtitle, amount })
+}
+
+// Same ISO 4217 snapshot as the wallet PaymentCurrency.kt (2026-09-17).
+fn minor_units(currency: &str) -> Option<usize> {
+    match currency {
+        "BIF" | "CLP" | "DJF" | "GNF" | "ISK" | "JPY" | "KMF" | "KRW" | "PYG" | "RWF" | "UGX"
+        | "UYI" | "VND" | "VUV" | "XAF" | "XOF" | "XPF" => Some(0),
+        "AED" | "AFN" | "ALL" | "AMD" | "AOA" | "ARS" | "AUD" | "AWG" | "AZN" | "BAM" | "BBD"
+        | "BDT" | "BMD" | "BND" | "BOB" | "BOV" | "BRL" | "BSD" | "BTN" | "BWP" | "BYN" | "BZD"
+        | "CAD" | "CDF" | "CHE" | "CHF" | "CHW" | "CNY" | "COP" | "COU" | "CRC" | "CUP" | "CVE"
+        | "CZK" | "DKK" | "DOP" | "DZD" | "EGP" | "ERN" | "ETB" | "EUR" | "FJD" | "FKP" | "GBP"
+        | "GEL" | "GHS" | "GIP" | "GMD" | "GTQ" | "GYD" | "HKD" | "HNL" | "HTG" | "HUF" | "IDR"
+        | "ILS" | "INR" | "IRR" | "JMD" | "KES" | "KGS" | "KHR" | "KPW" | "KYD" | "KZT" | "LAK"
+        | "LBP" | "LKR" | "LRD" | "LSL" | "MAD" | "MDL" | "MGA" | "MKD" | "MMK" | "MNT" | "MOP"
+        | "MRU" | "MUR" | "MVR" | "MWK" | "MXN" | "MXV" | "MYR" | "MZN" | "NAD" | "NGN" | "NIO"
+        | "NOK" | "NPR" | "NZD" | "PAB" | "PEN" | "PGK" | "PHP" | "PKR" | "PLN" | "QAR" | "RON"
+        | "RSD" | "RUB" | "SAR" | "SBD" | "SCR" | "SDG" | "SEK" | "SGD" | "SHP" | "SLE" | "SOS"
+        | "SRD" | "SSP" | "STN" | "SVC" | "SYP" | "SZL" | "THB" | "TJS" | "TMT" | "TOP" | "TRY"
+        | "TTD" | "TWD" | "TZS" | "UAH" | "USD" | "USN" | "UYU" | "UZS" | "VED" | "VES" | "WST"
+        | "XAD" | "XCD" | "XCG" | "YER" | "ZAR" | "ZMW" | "ZWG" => Some(2),
+        "BHD" | "IQD" | "JOD" | "KWD" | "LYD" | "OMR" | "TND" => Some(3),
+        "CLF" | "UYW" => Some(4),
+        _ => None,
+    }
+}
