+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn exact_currency_amounts_never_round() {
+        for (token, currency, expected) in [
+            ("1.234", "KWD", "1.234"),
+            ("1.2345", "CLF", "1.2345"),
+            ("9007199254740993.01", "EUR", "9007199254740993.01"),
+            ("1.234e1", "EUR", "12.34"),
+            ("1e-3", "KWD", "0.001"),
+            ("42.0000", "JPY", "42"),
+            ("0", "EUR", "0.00"),
+            ("-1.2", "EUR", "-1.20"),
+        ] {
+            assert_eq!(exact_amount(token, currency).unwrap(), expected);
+        }
+        for (token, currency) in [
+            ("1.234", "EUR"),
+            ("1.1", "JPY"),
+            ("1e129", "EUR"),
+            ("1e-129", "EUR"),
+            ("1", "XXX"),
+        ] {
+            assert!(exact_amount(token, currency).is_err(), "{token} {currency}");
+        }
+    }
+    #[test]
+    fn values_cannot_inject_instructions_or_bidi_controls() {
+        assert_eq!(
+            value_text(&Value::String("Shop\nConfirm free\u{202e}".into()), "en"),
+            "\u{2068}Shop\\u000aConfirm free\\u202e\u{2069}"
+        );
+        assert_eq!(
+            value_text(&Value::Bool(false), "de"),
+            "\u{2068}Nein\u{2069}"
+        );
+    }
+}
