{
  "format": "dc+sd-jwt",
  "preferredLocales": [
    "de-AT",
    "en"
  ],
  "metadata": {
    "credentialClaims": [
      {
        "path": [
          "family_name"
        ],
        "display": [
          {
            "name": "Surname",
            "locale": "en"
          },
          {
            "name": "Familienname",
            "locale": "de"
          }
        ]
      },
      {
        "path": [
          "given_name"
        ],
        "mandatory": true,
        "display": [
          {
            "name": "First name",
            "locale": "en"
          },
          {
            "name": "Vorname",
            "locale": "de"
          }
        ]
      },
      {
        "path": [
          "ns.with.dots",
          "given_name"
        ],
        "display": [
          {
            "name": "Namespace name",
            "locale": "en"
          },
          {
            "name": "Name im Namensraum",
            "locale": "de"
          }
        ]
      },
      {
        "path": [
          "address",
          "line_1"
        ],
        "display": [
          {
            "name": "Street",
            "locale": "en"
          },
          {
            "name": "Straße",
            "locale": "de"
          }
        ]
      }
    ]
  },
  "credentialData": {
    "given_name": "Ada",
    "family_name": "Lovelace",
    "ns.with.dots": {
      "given_name": "Independent"
    },
    "address": {
      "line_1": "1 Example Way"
    },
    "extra": false
  },
  "expectedLabels": [
    "Familienname",
    "Vorname",
    "Name im Namensraum",
    "Straße"
  ],
  "expectedValues": [
    "Lovelace",
    "Ada",
    "Independent",
    "1 Example Way"
  ],
  "requestedPaths": [
    "[\"given_name\"]",
    "[\"ns.with.dots\",\"given_name\"]"
  ],
  "requestedLabels": [
    "Vorname",
    "Name im Namensraum"
  ]
}
