<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.id.walt.wallet.native</string>
	</array>
	<!--
	  The shared group is listed first on purpose: iOS uses the first entry as the default access
	  group for any keychain item written without an explicit kSecAttrAccessGroup. Signum's
	  IosKeychainProvider does not expose that attribute, so this ordering is what puts the wallet
	  signing key and its metadata where the document-provider extension can read them.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)id.walt.wallet.native.shared</string>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<!--
	  The host app - not only the extension - reads and mutates
	  IdentityDocumentProviderRegistrationStore, so it needs the Mobile Document Provider capability
	  too. The App ID must have it enabled in the developer portal for both Debug and Release
	  provisioning profiles; without that, signing fails on this key rather than at runtime.
	-->
	<key>com.apple.developer.identity-document-services.document-provider.mobile-document-types</key>
	<array>
		<string>org.iso.18013.5.1.mDL</string>
		<string>eu.europa.ec.eudi.pid.1</string>
	</array>
	<!-- Apple-assigned host-card-emulation capability for the demo app's approved ISO AIDs. -->
	<key>com.apple.developer.nfc.hce</key>
	<true/>
	<key>com.apple.developer.nfc.hce.iso7816.select-identifier-prefixes</key>
	<array>
		<string>D2760000850101</string>
		<string>A0000002480400</string>
		<string>A0000002480401</string>
	</array>
</dict>
</plist>
