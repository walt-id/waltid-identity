<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug only, for DigitalCredentialBrowserSharingE2ETest: Android 11+ package visibility hides
      Chrome from getPackageInfo, so the test cannot tell "not installed" from "not visible" and
      would silently skip itself. The wallet itself never queries browsers.
    -->
    <queries>
        <package android:name="com.android.chrome" />
    </queries>

    <application>
        <activity
            android:name=".DigitalCredentialTestVerifierActivity"
            android:exported="false" />
    </application>
</manifest>
