VERSION_TAG=stable
# Images for ARM (eg. Apple Silicon) are only available with the `latest` tag

VERSION_OPA=1.4.2
VERSION_VAULT=1.19.3
VERSION_VC_REPO=latest

IMAGE_PREFIX=""
#IMAGE_PREFIX="docker.io/"

SERVICE_HOST=host.docker.internal
#SERVICE_HOST=localhost
PUBLIC_SERVICE_HOST=localhost

# Current Services
ISSUER_API2_PORT=7005
VERIFIER_API2_PORT=7004
WALLET_API2_PORT=7006
WEB_PORTAL2_PORT=7105
WALLET_DEMO_COMPOSE_WEB_PORT=7106

# Optional Compose web wallet branding (same tokens as WalletDemoBranding on mobile).
# Leave empty to keep the walt.id defaults shipped in branding.json.
WALLET_BRAND_APP_TITLE=
WALLET_BRAND_PRIMARY=
WALLET_BRAND_ON_PRIMARY=
WALLET_BRAND_SECONDARY=
WALLET_BRAND_ON_SECONDARY=
WALLET_BRAND_PRIMARY_CONTAINER=
WALLET_BRAND_ON_PRIMARY_CONTAINER=

# Optional Portal2 verifier advanced security presets
WEB_PORTAL2_VERIFIER_KEY_JWK=
WEB_PORTAL2_VERIFIER_X5C=
WEB_PORTAL2_VERIFIER_CLIENT_ID=

# Portal2 Enterprise issuer routing. Leave empty until the demo issuer services exist.
# Do not commit WEB_PORTAL2_ES_EMAIL / WEB_PORTAL2_ES_PASSWORD values.
WEB_PORTAL2_ES_BASE_URL=
WEB_PORTAL2_ES_EMAIL=
WEB_PORTAL2_ES_PASSWORD=
WEB_PORTAL2_ES_EUDI_REF_ISSUER_TARGET=
WEB_PORTAL2_ES_FRANCE_IDENTITE_ISSUER_TARGET=
WEB_PORTAL2_ES_DYOU_ISSUER_TARGET=

# Credential Repository
VC_REPO_PORT=7103

# Dependency Services
VAULT_PORT=8200
OPA_SERVER_PORT=8181

#database
DB_NAME=waltid
DB_USERNAME=waltid
DB_PASSWORD=waltid

#postgres
POSTGRES_DB_PORT=5432
POSTGRES_DB_HOST=postgres # compose service name
PG_ADMIN_PORT=8080

#identity | identity,tse | identity,opa | services | identity,valkey | all
COMPOSE_PROFILES=identity
