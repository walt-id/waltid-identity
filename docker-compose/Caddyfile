    reverse_proxy http://issuer-api2:{$ISSUER_API2_PORT}
}

# Verifier API2
:{$VERIFIER_API2_PORT} {
    reverse_proxy http://verifier-api2:{$VERIFIER_API2_PORT}
}

# Wallet API2
:{$WALLET_API2_PORT} {
    reverse_proxy http://wallet-api2:{$WALLET_API2_PORT}
}

# Web Portal2
:{$WEB_PORTAL2_PORT} {
    reverse_proxy http://web-portal2:{$WEB_PORTAL2_PORT}
}

# Compose Web Wallet
:{$WALLET_DEMO_COMPOSE_WEB_PORT} {
